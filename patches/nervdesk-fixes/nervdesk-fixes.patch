+/// `addr()`（地址发现未就绪时 DirectAddrs 为空）→ 对端无地址可连 →
+/// 30s 超时。本函数保证消息携带可拨号地址。
+pub fn enriched_addr(endpoint: &Endpoint) -> EndpointAddr {
+    let mut addrs = endpoint.addr().addrs.clone();
+    for s in endpoint.bound_sockets() {
+        addrs.insert(TransportAddr::Ip(s));
+    }
+    EndpointAddr {
+        id: endpoint.id(),
+        addrs,
+    }
