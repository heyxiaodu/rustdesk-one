+            assert_eq!(&decoded[..], &h1_client.finalize()[..], "h1 一致");
+            // 4) 挑战应答：客户端发送 sha256(h1+challenge)，响应方 verify_h1 同式比对
+            let challenge = "123456";
+            let mut client_send = Sha256::new();
+            client_send.update(&decoded);
+            client_send.update(challenge.as_bytes());
+            let sent = client_send.finalize();
+            let mut responder_check = Sha256::new();
+            responder_check.update(&decoded);
+            responder_check.update(challenge.as_bytes());
+            assert_eq!(
+                &sent[..],
+                &responder_check.finalize()[..],
+                "verify_h1 语义一致"
+            );
+        });
+    }
