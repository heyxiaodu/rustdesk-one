[Desktop Entry]
# NERV Desk: TryExec/Exec/Icon/StartupWMClass are machine-facing and must match the
# binary Linux packaging actually installs, which is still `rustdesk`
# (flutter/linux/CMakeLists.txt:7, res/DEBIAN/postinst). `Name` is display only.
Name=NERV Desk
NoDisplay=true
# The scheme stays `nervdesk`: it is registered by the application itself
# (get_uri_prefix() -> nervdesk://), while the binary name is decided by packaging.
MimeType=x-scheme-handler/nervdesk;
TryExec=rustdesk
Exec=rustdesk %u
Icon=rustdesk
Terminal=false
Type=Application
StartupNotify=false
StartupWMClass=rustdesk
