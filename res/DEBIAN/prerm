#!/bin/bash

set -e

case $1 in
    remove|upgrade)
		INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
		rm -f /usr/bin/rustdesk
		# NERV Desk (task-76): the desktop entry and the two icons are installed as
		# `nervdesk.*` now; clear the upstream-named files an older `rustdesk` package
		# left behind (best effort, non-systemd installs included).
		rm -f /usr/share/applications/rustdesk.desktop /usr/share/applications/rustdesk-link.desktop \
			/usr/share/icons/hicolor/256x256/apps/rustdesk.png \
			/usr/share/icons/hicolor/scalable/apps/rustdesk.svg || true
		
		if [ "systemd" == "${INITSYS}" ]; then

			systemctl stop nervdesk || true
			systemctl disable nervdesk || true
			rm -f /etc/systemd/system/nervdesk.service /usr/lib/systemd/system/nervdesk.service || true
			# NERV Desk (task-76): also clear the upstream unit, so an upgrade from a stock
			# `rustdesk` package cannot leave an enabled `rustdesk.service` behind.
			systemctl disable rustdesk.service >/dev/null 2>&1 || true
			rm -f /etc/systemd/system/rustdesk.service /usr/lib/systemd/system/rustdesk.service
			
			# workaround temp dev build between 1.1.9 and 1.2.0
			serverUser=$(ps -ef | grep -E 'rustdesk +--server' | grep -v 'sudo ' | awk '{print $1}' | head -1)
			if [ "$serverUser" != "" ] && [ "$serverUser" != "root" ]
			then
				systemctl --machine=${serverUser}@.host --user stop nervdesk >/dev/null 2>&1 || true
			fi
			rm -f /usr/lib/systemd/user/nervdesk.service /usr/lib/systemd/user/rustdesk.service >/dev/null 2>&1 || true
		fi
        ;;
esac

exit 0
