# The package name is the OEM identity. The provides/conflicts/replaces triad below is what makes
# `pacman -U` of this package replace an installed rustdesk: both own /usr/share/rustdesk and
# /usr/bin/rustdesk, so pacman refuses the install on a file conflict without it. NERV Desk (task-69).
pkgname=nervdesk
pkgver=1.5.0
pkgrel=0
epoch=
pkgdesc=""
arch=('x86_64')
url=""
license=('AGPL-3.0')
groups=()
depends=('gtk3' 'xdotool' 'libxcb' 'libxfixes' 'alsa-lib' 'libva' 'libappindicator-gtk3' 'gst-plugins-base' 'gst-plugin-pipewire')
makedepends=()
checkdepends=()
optdepends=()
provides=('rustdesk')
conflicts=('rustdesk')
replaces=('rustdesk')
backup=()
options=()
install=pacman_install
changelog=
noextract=()
md5sums=() #generate with 'makepkg -g'

package() {
  if [[ ${FLUTTER} ]]; then
	  mkdir -p "${pkgdir}/usr/share/rustdesk" && cp -r ${HBB}/flutter/build/linux/x64/release/bundle/* -t "${pkgdir}/usr/share/rustdesk"
  fi
  mkdir -p "${pkgdir}/usr/bin"
  pushd ${pkgdir} && ln -s /usr/share/rustdesk/rustdesk usr/bin/rustdesk && popd
  install -Dm 644 $HBB/res/nervdesk.service -t "${pkgdir}/usr/share/rustdesk/files"
  install -Dm 644 $HBB/res/nervdesk.desktop -t "${pkgdir}/usr/share/rustdesk/files"
  install -Dm 644 $HBB/res/nervdesk-link.desktop -t "${pkgdir}/usr/share/rustdesk/files"
  install -Dm 644 $HBB/res/128x128@2x.png "${pkgdir}/usr/share/icons/hicolor/256x256/apps/nervdesk.png"
  install -Dm 644 $HBB/res/scalable.svg "${pkgdir}/usr/share/icons/hicolor/scalable/apps/nervdesk.svg"
}
