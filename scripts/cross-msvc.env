# NERV Desk — Windows x86_64-msvc cross-compile environment.
#
# WHY THIS FILE EXISTS
# --------------------
# `.cargo/config.toml` `[target.<triple>]` tables do NOT export arbitrary keys as
# environment variables to build scripts. Verified empirically (m09628): a build
# script running under `--target=x86_64-pc-windows-msvc` sees
# `CC_x86_64_pc_windows_msvc = None` even when the key is present in
# `[target.x86_64-pc-windows-msvc]` as `{ value = "...", force = "false" }`.
#
# Consequence: cc-rs falls back to a bare `clang`/`cc` from PATH, which emits
# **ELF** .o files, and `lib.exe` then fails with
#   "not a COFF object, bitcode, archive, import library or resource file".
#
# A global `[env]` block is NOT an acceptable fix either: the global-named keys
# (KCP_SYS_EXTRA_HEADER_PATH) would leak into host (linux-gnu) builds and break
# kcp-sys's bindgen on MSVC `<vadefs.h>` (regression history: m09301/m09349).
#
# So: source this file in the shell for cross builds only.
#
# USAGE
#   scripts/cross-build-msvc.sh --features quic
# or manually, from the repository root:
#   export NERV_REPO_ROOT="$PWD"
#   set -a; . scripts/cross-msvc.env; set +a
#   cargo build --target=x86_64-pc-windows-msvc --features quic
#
# EXTERNAL DEPENDENCIES (deliberately not committed to this repository)
#   $NERV_SHIM   clang-wrap.sh + link.sh          (default /tmp/nervdesk-msvc-shim)
#   $NERV_XWIN   xwin-splatted MSVC CRT + SDK     (default $HOME/.xwin)
#   $NERV_BE/analysis/build-env/nervdesk-*-msvc   hand-rolled COFF .lib archives
# All three are overridable from the environment; the driver fails loudly if the
# shim is missing rather than silently producing ELF objects.

NERV_REPO_ROOT="${NERV_REPO_ROOT:-$PWD}"
NERV_BE="${NERV_BE:-$(cd "$NERV_REPO_ROOT/../.." 2>/dev/null && pwd || printf '%s' "$NERV_REPO_ROOT")}"
NERV_XWIN="${NERV_XWIN:-$HOME/.xwin}"
NERV_SHIM="${NERV_SHIM:-/tmp/nervdesk-msvc-shim}"

NERV_XWIN_CFLAGS="--target=x86_64-pc-windows-msvc -fuse-ld=lld"
NERV_XWIN_CFLAGS="$NERV_XWIN_CFLAGS -I$NERV_XWIN/crt/include"
NERV_XWIN_CFLAGS="$NERV_XWIN_CFLAGS -I$NERV_XWIN/sdk/include/um"
NERV_XWIN_CFLAGS="$NERV_XWIN_CFLAGS -I$NERV_XWIN/sdk/include/shared"
NERV_XWIN_CFLAGS="$NERV_XWIN_CFLAGS -I$NERV_XWIN/sdk/include/ucrt"
NERV_XWIN_CFLAGS="$NERV_XWIN_CFLAGS -I$NERV_XWIN/sdk/include/winrt"

# cc-rs compiler selection — the whole point of this file.
CC_x86_64_pc_windows_msvc="$NERV_SHIM/clang-wrap.sh"
CXX_x86_64_pc_windows_msvc="$NERV_SHIM/clang-wrap.sh"
AR_x86_64_pc_windows_msvc="/usr/bin/llvm-lib-19"
CFLAGS_x86_64_pc_windows_msvc="$NERV_XWIN_CFLAGS"
CXXFLAGS_x86_64_pc_windows_msvc="$NERV_XWIN_CFLAGS"

# kcp-sys bindgen include path (libclang does not inherit CFLAGS).
KCP_SYS_EXTRA_HEADER_PATH="$NERV_XWIN/crt/include:$NERV_XWIN/sdk/include/ucrt:$NERV_XWIN/sdk/include/shared"

# Hand-rolled COFF .lib locations for the cross-built native libs.
NERV_SODIUM_LIB_DIR="$NERV_BE/analysis/build-env/nervdesk-sodium-msvc"
NERV_SODIUM_INCLUDE_DIR="$NERV_BE/analysis/build-env/nervdesk-sodium-msvc/include"
NERV_LIBAOM_DIR="$NERV_BE/analysis/build-env/nervdesk-aom-msvc/lib"
NERV_LIBVPX_DIR="$NERV_BE/analysis/build-env/nervdesk-vpx-msvc/lib"
NERV_LIBYUV_DIR="$NERV_BE/analysis/build-env/nervdesk-yuv-msvc/lib"

# lld-link diagnostics.
NERV_LINK_LOG="${NERV_LINK_LOG:-/tmp/nerv-link.log}"
NERV_LINK_VERBOSE="${NERV_LINK_VERBOSE:-1}"

export NERV_REPO_ROOT NERV_BE NERV_XWIN NERV_SHIM
export CC_x86_64_pc_windows_msvc CXX_x86_64_pc_windows_msvc AR_x86_64_pc_windows_msvc
export CFLAGS_x86_64_pc_windows_msvc CXXFLAGS_x86_64_pc_windows_msvc
export KCP_SYS_EXTRA_HEADER_PATH
export NERV_SODIUM_LIB_DIR NERV_SODIUM_INCLUDE_DIR
export NERV_LIBAOM_DIR NERV_LIBVPX_DIR NERV_LIBYUV_DIR
export NERV_LINK_LOG NERV_LINK_VERBOSE
